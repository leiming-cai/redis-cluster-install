+        // 显式转 Object 选中 String.valueOf(Object)，否则泛型实参会被推断成 char[]（valueOf 最具体重载）
+        when(serializer.serialize(any())).thenAnswer(
+                invocation -> String.valueOf((Object) invocation.getArgument(0)).getBytes(StandardCharsets.UTF_8));
+        return serializer;
+    }
