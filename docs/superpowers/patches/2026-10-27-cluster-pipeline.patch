+package com.sac.platform.realserver.oms.utils;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.concurrent.locks.ReentrantLock;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.data.redis.connection.RedisConnection;
+import org.springframework.data.redis.connection.RedisConnectionFactory;
+import org.springframework.data.redis.connection.jedis.JedisClusterConnection;
+import org.springframework.data.redis.core.HashOperations;
+import org.springframework.data.redis.core.RedisTemplate;
+import org.springframework.data.redis.serializer.RedisSerializer;
+
+import redis.clients.jedis.Jedis;
+import redis.clients.jedis.JedisCluster;
+import redis.clients.jedis.JedisPool;
+import redis.clients.jedis.Pipeline;
+import redis.clients.jedis.exceptions.JedisAskDataException;
+import redis.clients.jedis.exceptions.JedisConnectionException;
+import redis.clients.jedis.exceptions.JedisDataException;
+import redis.clients.jedis.util.JedisClusterCRC16;
+
+/**
+ * 集群模式下按节点 pipeline 写 hash。
+ * @Author: caileiming boboclmomi@163.com
+ * @Date: 2026-10-27
+ * @Description: 把「每 key 一次同步 HSET 往返」变成「每主节点一次 pipeline 往返」。
+ *               槽位快照来自 CLUSTER SLOTS（host 在 Jedis 3.10 里是 byte[]）；
+ *               集群模式固定 db 0（Redis Cluster 不支持 SELECT）。
+ *               连接不是 Jedis 集群（单机/哨兵）时自动退化为逐 key 写入；
+ *               该判定按实例缓存且永久有效，不会被后续批次重新探测。
+ *               Pipeline.hset(byte[], Map) 发出的是多 field 的 HSET，要求 Redis >= 4.0
+ *               （旧路径用的是 HMSET）；目标镜像为 Redis 8.10。
+ */
+public class RedisClusterHashPipeline {
+
+    private static final Logger logger = LoggerFactory.getLogger(RedisClusterHashPipeline.class);
+
+    static final long SLOT_CACHE_TTL_MS = 30000L;
+    private static final long REFRESH_RETRY_MS = 5000L;
+    /** 强制刷新（重定向触发）的最小间隔：16 个线程同时收到 MOVED 时也只探测一次。 */
+    private static final long FORCED_REFRESH_MIN_INTERVAL_MS = 1000L;
+
+    private final RedisTemplate<String, Object> redisTemplate;
+    private final RedisConnectionFactory connectionFactory;
+
+    private final AtomicReference<SlotSnapshot> snapshotRef = new AtomicReference<SlotSnapshot>();
+    private final ReentrantLock refreshLock = new ReentrantLock();
+
+    /** 上次刷新整体失败后的时间点；在此之前不再逐节点探测，避免 NOPERM 之类永久失败打成风暴。 */
+    private volatile long refreshRetryAt;
+
+    /** 上次强制刷新（重定向触发）的探测时间，成功与否都记；用来给强制刷新留 1 秒下限。 */
+    private volatile long lastForcedRefreshAt;
+
+    private volatile JedisCluster cluster;
+
+    /** nativeUnavailable 与 cluster 互斥：先看 nativeUnavailable，为 true 时 cluster 必为 null。 */
+    private final Object nativeLock = new Object();
+
+    /** 连接不是 JedisClusterConnection（单机/哨兵部署）：判定一次就记住，别每个批次都去借连接。 */
+    private volatile boolean nativeUnavailable;
+
+    public RedisClusterHashPipeline(RedisTemplate<String, Object> redisTemplate,
+            RedisConnectionFactory connectionFactory) {
+        this.redisTemplate = redisTemplate;
+        this.connectionFactory = connectionFactory;
+    }
+
+    /** 一个槽位区间及其主节点；host/port 只用来拼出 hostPort，不必各存一份。 */
+    static final class SlotRange {
+        final int start;
+        final int end;
+        /** hostPort 会被 ownerOf 逐 key 调用，构造时拼好，避免热路径重复拼接字符串。 */
+        final String hostPort;
+
+        SlotRange(int start, int end, String host, int port) {
+            this.start = start;
+            this.end = end;
+            this.hostPort = host + ":" + port;
+        }
+
+        String hostPort() {
+            return hostPort;
+        }
+    }
+
+    /** 不可变的槽位快照：ranges 在构造时复制为不可修改列表，ownerOf 用二分查找。 */
+    static final class SlotSnapshot {
+        final List<SlotRange> ranges;
+        final long createdAt;
+
+        SlotSnapshot(List<SlotRange> ranges, long createdAt) {
+            this.ranges = Collections.unmodifiableList(new ArrayList<SlotRange>(ranges));
+            this.createdAt = createdAt;
+        }
+
+        String ownerOf(int slot) {
+            int low = 0;
+            int high = ranges.size() - 1;
+            while (low <= high) {
+                int mid = (low + high) >>> 1;
+                SlotRange range = ranges.get(mid);
+                if (slot < range.start) {
+                    high = mid - 1;
+                } else if (slot > range.end) {
+                    low = mid + 1;
+                } else {
+                    return range.hostPort();
+                }
+            }
+            return null;
+        }
+
+        /**
+         * 是否连续覆盖 0..16383 全部槽位。仅用于测试，生产路径不使用。
+         * 注意这只说明「槽位地图完整」，不代表地图可信：集群配置
+         * cluster-require-full-coverage no 时会合法地只上报部分槽位，
+         * 此时返回 false 属于正常情况，调用方仍可按已覆盖的槽位写入。
+         */
+        boolean isComplete() {
+            int next = 0;
+            for (SlotRange range : ranges) {
+                if (range.start != next) {
+                    return false;
+                }
+                next = range.end + 1;
+            }
+            return next == 16384;
+        }
+    }
+
+    /**
+     * 把一批 key -> hash 的写入按 slot 属主归并，每个主节点一条 pipeline。
+     * 主节点不可达、pipeline 返回值与提交数不一致、或被服务端拒绝的 key，都会刷新拓扑后
+     * 改走逐 key 写入（JedisCluster 自己会 renewSlotCache + 重定向重试），不抛给调用方；
+     * 只有逐 key 兜底本身失败（传输层错误、序列化失败）才会抛出 RuntimeException。
+     * 调用方必须整批重试：HSET 对相同 field 幂等，且抛错时已应用的 key 集合不确定。
+     */
+    public void putAllHashes(Map<String, ? extends Map<String, ?>> keyedHashes) {
+        if (keyedHashes == null || keyedHashes.isEmpty()) {
+            return;
+        }
+        JedisCluster jedisCluster = clusterOrNull();
+        if (jedisCluster == null) {
+            writePerKey(keyedHashes.keySet(), keyedHashes);
+            return;
+        }
+
+        SlotSnapshot snapshot = snapshot(false);
+        Map<String, List<String>> byNode = new LinkedHashMap<String, List<String>>();
+        List<String> unmapped = new ArrayList<String>();
+        if (snapshot == null) {
+            unmapped.addAll(keyedHashes.keySet());
+        } else {
+            for (Map.Entry<String, ? extends Map<String, ?>> entry : keyedHashes.entrySet()) {
+                if (entry.getValue() == null || entry.getValue().isEmpty()) {
+                    continue;
+                }
+                int slot = JedisClusterCRC16.getSlot(keyBytes(entry.getKey()));
+                String owner = snapshot.ownerOf(slot);
+                if (owner == null) {
+                    unmapped.add(entry.getKey());
+                    continue;
+                }
+                List<String> keys = byNode.get(owner);
+                if (keys == null) {
+                    keys = new ArrayList<String>();
+                    byNode.put(owner, keys);
+                }
+                keys.add(entry.getKey());
+            }
+        }
+
+        List<String> failedKeys = new ArrayList<String>();
+        boolean needsTopologyRefresh = false;
+        for (Map.Entry<String, List<String>> entry : byNode.entrySet()) {
+            JedisPool pool = poolFor(jedisCluster, entry.getKey());
+            if (pool == null) {
+                logger.warn("No JedisPool for {}; writing {} keys one by one", entry.getKey(), entry.getValue().size());
+                // 节点池对不上说明拓扑已经过时，本批结束时刷新一次
+                needsTopologyRefresh = true;
+                writePerKey(entry.getValue(), keyedHashes);
+                continue;
+            }
+            PipelineOutcome outcome;
+            try {
+                outcome = runPipeline(pool, entry.getValue(), keyedHashes);
+            } catch (JedisConnectionException e) {
+                // 本类不共享 JedisCluster 的 slot 缓存，连接级失败必须自己刷新拓扑；
+                // 这批 key 交给 JedisCluster 逐 key 写，它会 renewSlotCache + 重试（旧路径的行为）。
+                logger.warn("Node {} unreachable ({}); refreshing topology and writing {} keys one by one",
+                        entry.getKey(), e.getMessage(), entry.getValue().size());
+                refreshQuietly();
+                writePerKey(entry.getValue(), keyedHashes);
+                continue;
+            }
+            if (!outcome.failed.isEmpty()) {
+                logger.warn("Pipeline on node {} rejected {} of {} keys (first: {}): {}",
+                        entry.getKey(), outcome.failed.size(), entry.getValue().size(),
+                        preview(outcome.failed.get(0)), outcome.firstReason);
+                failedKeys.addAll(outcome.failed);
+                needsTopologyRefresh |= outcome.refreshNeeded;
+            }
+        }
+        if (needsTopologyRefresh) {
+            refreshQuietly();
+        }
+        if (!failedKeys.isEmpty()) {
+            writePerKey(failedKeys, keyedHashes);
+        }
+
+        if (!unmapped.isEmpty()) {
+            logger.warn("{} keys have no slot owner in the cached topology; writing them one by one", unmapped.size());
+            writePerKey(unmapped, keyedHashes);
+        }
+    }
+
+    private JedisCluster clusterOrNull() {
+        if (nativeUnavailable) {
+            return null;
+        }
+        JedisCluster cached = cluster;
+        if (cached != null) {
+            return cached;
+        }
+        synchronized (nativeLock) {
+            if (nativeUnavailable) {
+                return null;
+            }
+            if (cluster != null) {
+                return cluster;
+            }
+            RedisConnection connection = connectionFactory.getConnection();
+            try {
+                if (!(connection instanceof JedisClusterConnection)) {
+                    nativeUnavailable = true;
+                    logger.info("Pipeline acceleration unavailable (connection is {}); writing one key at a time",
+                            connection.getClass().getName());
+                    return null;
+                }
+                cluster = ((JedisClusterConnection) connection).getNativeConnection();
+                if (cluster == null) {
+                    nativeUnavailable = true;
+                    logger.info("JedisClusterConnection returned no native cluster; writing one key at a time");
+                    return null;
+                }
+                return cluster;
+            } finally {
+                try {
+                    connection.close();
+                } catch (Exception e) {
+                    logger.debug("Failed to close the borrowed RedisConnection: {}", e.getMessage());
+                }
+            }
+        }
+    }
+
+    private SlotSnapshot snapshot(boolean force) {
+        long now = System.currentTimeMillis();
+        SlotSnapshot current = snapshotRef.get();
+        if (!force && current != null && now - current.createdAt < SLOT_CACHE_TTL_MS) {
+            return current;
+        }
+        // 退避窗口内不再探测。current 可能为 null（从未成功过），此时也必须返回 null，
+        // 让调用方直接走逐 key 兜底，而不是把每个批次都拿去重探一遍所有节点。
+        // 强制刷新是例外：收到 MOVED 说明手里的表已被证明是错的，必须探；
+        // 但 5 秒退避期内的探测同样受下面 1 秒下限约束，不会打成风暴。
+        // 下限只统计强制刷新：正常的 TTL 刷新不该挡住紧随其后的第一次重定向刷新。
+        if (!force && now < refreshRetryAt) {
+            return current;
+        }
+        if (force && now - lastForcedRefreshAt < FORCED_REFRESH_MIN_INTERVAL_MS) {
+            return current;
+        }
+        boolean locked;
+        try {
+            locked = refreshLock.tryLock(50, TimeUnit.MILLISECONDS);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return current;
+        }
+        if (!locked) {
+            return current;
+        }
+        try {
+            long lockedAt = System.currentTimeMillis();
+            SlotSnapshot again = snapshotRef.get();
+            if (!force && again != null && lockedAt - again.createdAt < SLOT_CACHE_TTL_MS) {
+                return again;
+            }
+            if (!force && lockedAt < refreshRetryAt) {
+                return again;
+            }
+            // 同一秒内已经有线程强制探过了：排在锁后面的强制刷新直接复用它的结果，
+            // 否则 16 个线程会把一次 MOVED 放大成 16 次 CLUSTER SLOTS。
+            if (force && lockedAt - lastForcedRefreshAt < FORCED_REFRESH_MIN_INTERVAL_MS) {
+                return again;
+            }
+            if (force) {
+                lastForcedRefreshAt = lockedAt;
+            }
+            JedisCluster jedisCluster = clusterOrNull();
+            if (jedisCluster == null) {
+                return again;
+            }
+            Map<String, JedisPool> nodes = pools(jedisCluster);
+            for (Map.Entry<String, JedisPool> node : nodes.entrySet()) {
+                Jedis seed = null;
+                try {
+                    seed = node.getValue().getResource();
+                    List<Object> reply = seed.clusterSlots();
+                    SlotSnapshot fresh = parseSlotSnapshot(reply, System.currentTimeMillis());
+                    if (fresh.ranges.isEmpty()) {
+                        logger.warn("CLUSTER SLOTS via {} produced no usable ranges; trying the next node", node.getKey());
+                        continue;
+                    }
+                    snapshotRef.set(fresh);
+                    refreshRetryAt = 0L;
+                    return fresh;
+                } catch (Exception e) {
+                    logger.warn("Failed to refresh cluster slots via {}: {}", node.getKey(), e.getMessage());
+                } finally {
+                    if (seed != null) {
+                        try {
+                            seed.close();
+                        } catch (Exception e) {
+                            logger.debug("Failed to close the seed connection: {}", e.getMessage());
+                        }
+                    }
+                }
+            }
+            logger.warn("Could not refresh cluster slots from any node; keeping the previous snapshot");
+            refreshRetryAt = System.currentTimeMillis() + REFRESH_RETRY_MS;
+            return again;
+        } finally {
+            refreshLock.unlock();
+        }
+    }
+
+    private JedisPool poolFor(JedisCluster jedisCluster, String hostPort) {
+        return pools(jedisCluster).get(hostPort);
+    }
+
+    private Map<String, JedisPool> pools(JedisCluster jedisCluster) {
+        Map<String, JedisPool> nodes = jedisCluster.getClusterNodes();
+        return nodes == null ? Collections.<String, JedisPool>emptyMap() : nodes;
+    }
+
+    /** 一条 pipeline 的结果：哪些 key 被拒、是否需要刷新拓扑、第一条拒绝原因（只用于日志）。 */
+    private static final class PipelineOutcome {
+        final List<String> failed;
+        final boolean refreshNeeded;
+        final String firstReason;
+
+        PipelineOutcome(List<String> failed, boolean refreshNeeded, String firstReason) {
+            this.failed = failed;
+            this.refreshNeeded = refreshNeeded;
+            this.firstReason = firstReason;
+        }
+
+        static PipelineOutcome none() {
+            return new PipelineOutcome(Collections.<String>emptyList(), false, null);
+        }
+    }
+
+    /**
+     * 返回本批被服务端拒绝的 key。pipeline 里的 MOVED/ASK 是「返回值」不是异常：
+     * syncAndReturnAll() 会把 JedisDataException 装进返回列表（实测）。
+     */
+    private PipelineOutcome runPipeline(JedisPool pool, List<String> keys,
+            Map<String, ? extends Map<String, ?>> keyedHashes) {
+        Jedis jedis = pool.getResource();
+        Pipeline pipeline = null;
+        boolean synced = false;
+        try {
+            pipeline = jedis.pipelined();
+            for (String key : keys) {
+                pipeline.hset(keyBytes(key), hashBytes(keyedHashes.get(key)));
+            }
+            List<Object> replies = pipeline.syncAndReturnAll();
+            synced = true;
+            if (replies == null || replies.size() != keys.size()) {
+                return new PipelineOutcome(keys, true, "reply count mismatch");
+            }
+            List<String> failed = new ArrayList<String>();
+            boolean refreshNeeded = false;
+            String firstReason = null;
+            for (int i = 0; i < replies.size(); i++) {
+                Object reply = replies.get(i);
+                if (reply instanceof Long) {
+                    continue;
+                }
+                if (!(reply instanceof JedisDataException)) {
+                    if (firstReason == null) {
+                        firstReason = "unexpected reply type " + reply;
+                    }
+                    failed.add(keys.get(i));
+                    refreshNeeded = true;
+                    continue;
+                }
+                if (firstReason == null) {
+                    firstReason = ((JedisDataException) reply).getMessage();
+                }
+                failed.add(keys.get(i));
+                // ASK 是迁移中的临时状态，按 Jedis 的正常重定向重试即可，不需要刷新拓扑
+                if (!(reply instanceof JedisAskDataException)) {
+                    refreshNeeded = true;
+                }
+            }
+            if (failed.isEmpty()) {
+                return PipelineOutcome.none();
+            }
+            return new PipelineOutcome(failed, refreshNeeded, firstReason);
+        } finally {
+            if (!synced && pipeline != null) {
+                // 构建期异常：先把已排队的命令刷出去，恢复协议对齐；本批会被上游整批重试
+                try {
+                    pipeline.sync();
+                } catch (Exception e) {
+                    logger.warn("Failed to drain an aborted pipeline: {}", e.getMessage());
+                }
+            }
+            jedis.close();
+        }
+    }
+
+    private static String preview(String key) {
+        if (key == null || key.length() <= 120) {
+            return key;
+        }
+        return key.substring(0, 120) + "...";
+    }
+
+    private void refreshQuietly() {
+        try {
+            snapshot(true);
+        } catch (Exception e) {
+            logger.warn("Refresh cluster slots failed, falling back to per-key writes: {}", e.getMessage());
+        }
+    }
+
+    @SuppressWarnings({ "unchecked", "rawtypes" })
+    private void writePerKey(java.util.Collection<String> keys,
+            Map<String, ? extends Map<String, ?>> keyedHashes) {
+        HashOperations operations = redisTemplate.opsForHash();
+        for (String key : keys) {
+            Map<String, ?> hash = keyedHashes.get(key);
+            if (hash == null || hash.isEmpty()) {
+                continue;
+            }
+            operations.putAll(key, hash);
+        }
+    }
+
+    @SuppressWarnings("rawtypes")
+    private byte[] keyBytes(String key) {
+        RedisSerializer serializer = redisTemplate.getKeySerializer();
+        return (byte[]) serializer.serialize(key);
+    }
+
+    @SuppressWarnings({ "unchecked", "rawtypes" })
+    private Map<byte[], byte[]> hashBytes(Map<String, ?> hash) {
+        RedisSerializer keySerializer = redisTemplate.getHashKeySerializer();
+        RedisSerializer valueSerializer = redisTemplate.getHashValueSerializer();
+        Map<byte[], byte[]> serialized = new HashMap<byte[], byte[]>(Math.max(4, hash.size() * 2));
+        for (Map.Entry<String, ?> field : hash.entrySet()) {
+            serialized.put((byte[]) keySerializer.serialize(field.getKey()),
+                    (byte[]) valueSerializer.serialize(field.getValue()));
+        }
+        return serialized;
+    }
+
+    /**
+     * 解析 CLUSTER SLOTS 的原始回复：
+     * 每条 = [start(Long), end(Long), master([host(byte[]), port(Long), id(byte[])]), replica...]
+     * 无法解析或语义非法的条目直接跳过；区间重叠时整份回复作废，避免二分查找漏掉真实覆盖的槽位。
+     */
+    static SlotSnapshot parseSlotSnapshot(List<Object> reply, long now) {
+        List<SlotRange> ranges = new ArrayList<SlotRange>();
+        int skipped = 0;
+        if (reply != null) {
+            for (Object item : reply) {
+                if (!(item instanceof List)) {
+                    skipped++;
+                    continue;
+                }
+                List<?> entry = (List<?>) item;
+                if (entry.size() < 3 || !(entry.get(2) instanceof List)) {
+                    skipped++;
+                    continue;
+                }
+                if (!(entry.get(0) instanceof Number) || !(entry.get(1) instanceof Number)) {
+                    skipped++;
+                    continue;
+                }
+                int start = ((Number) entry.get(0)).intValue();
+                int end = ((Number) entry.get(1)).intValue();
+                if (start < 0 || end > 16383 || start > end) {
+                    skipped++;
+                    continue;
+                }
+                List<?> master = (List<?>) entry.get(2);
+                if (master.size() < 2 || !(master.get(1) instanceof Number)) {
+                    skipped++;
+                    continue;
+                }
+                Object hostValue = master.get(0);
+                if (hostValue == null) {
+                    skipped++;
+                    continue;
+                }
+                String host = decodeHost(hostValue);
+                int port = ((Number) master.get(1)).intValue();
+                if (port < 1 || port > 65535) {
+                    // 后续要 new Jedis(host, port)，这里的端口必须可用于建连
+                    skipped++;
+                    continue;
+                }
+                ranges.add(new SlotRange(start, end, host, port));
+            }
+        }
+        Collections.sort(ranges, new Comparator<SlotRange>() {
+            @Override
+            public int compare(SlotRange left, SlotRange right) {
+                return Integer.compare(left.start, right.start);
+            }
+        });
+        if (skipped > 0) {
+            logger.warn("CLUSTER SLOTS reply: skipped {} malformed entries, {} ranges parsed", skipped, ranges.size());
+        }
+        for (int i = 1; i < ranges.size(); i++) {
+            if (ranges.get(i).start <= ranges.get(i - 1).end) {
+                logger.warn("CLUSTER SLOTS map has overlapping ranges at slot {}, discarding the whole reply",
+                        ranges.get(i).start);
+                ranges.clear();
+                break;
+            }
+        }
+        int covered = 0;
+        for (SlotRange range : ranges) {
+            covered += range.end - range.start + 1;
+        }
+        if (covered < 16384) {
+            logger.warn("CLUSTER SLOTS map is incomplete: {} ranges cover {} of 16384 slots", ranges.size(), covered);
+        }
+        return new SlotSnapshot(ranges, now);
+    }
+
+    static String decodeHost(Object host) {
+        if (host instanceof byte[]) {
+            return new String((byte[]) host, StandardCharsets.UTF_8);
+        }
+        return String.valueOf(host);
+    }
+}
