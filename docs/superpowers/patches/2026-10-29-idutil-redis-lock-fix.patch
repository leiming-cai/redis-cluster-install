+        boolean locked = false;
         try {
-            boolean locked = RedisUtil.tryLock(key, "1", 5);
+            locked = Boolean.TRUE.equals(RedisUtil.tryLock(key, "1", 5));
             if (locked) {
                 RedisUtil redisUtil = new RedisUtil();
                 Object ret = redisUtil.getValue(key);
@@ -133,7 +145,21 @@ public class IdUtil {
             }
         } catch (Exception ex) {
             logger.error(ex);
-            RedisUtil.unLock(key);
+        } finally {
+            // 锁必须在 finally 里释放。
+            // 原来的写法是在成功路径上直接 return —— 没有人释放这把锁，
+            // 只能等它自己过期（TTL 是 5 秒）。这 5 秒里每一次取号都拿不到锁：
+            // 要么白等到锁过期（每次调用多等 5 秒），要么在等待超过 tryLock
+            // 的超时（10 秒）时彻底拿不到序列号。
+            if (locked) {
+                try {
+                    RedisUtil.unLock(key);
+                } catch (Exception releaseError) {
+                    // 序列号已经分配并写回了，释放失败不应该把这次取号变成失败
+                    // （调用方会重试，白白再消耗一个序列号）。
