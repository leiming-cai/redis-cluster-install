+oms:
+  # Redis 部署模式：standalone | cluster | sentinel
+  # 显式写出，不依赖默认值——默认值 standalone 会让下面 clusters 缺失时静默走错分支
+  redisMode: cluster
+  # 集群节点列表（host:port）。redisMode=cluster 时必填
+  # TODO(部署): 换成生产真实地址后，必须同步 Nacos 上同名配置
+  clusters:
+    - 127.0.0.1:6379
+  password: ""
+  # 集群模式固定 db 0（Redis Cluster 不支持 SELECT）
+  database: 0
+  timeout: 5000
+  connectTimeout: 2000
+  readTimeout: 5000
+  maxWait: 3000
+  # 连接池：三个应用并发量不同，可各自覆盖
+  maxTotal: 200
+  maxIdle: 50
+  minIdle: 10
