@@ -0,0 +1,130 @@
+package com.sac.platform.realserver.oms.utils;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import org.springframework.data.redis.connection.jedis.JedisClusterConnection;
+import org.springframework.data.redis.connection.jedis.JedisConnectionFactory;
+import org.springframework.data.redis.core.RedisTemplate;
+
+import redis.clients.jedis.Jedis;
+import redis.clients.jedis.JedisCluster;
+import redis.clients.jedis.JedisPool;
+import redis.clients.jedis.util.JedisClusterCRC16;
+
+/**
+ * 真集群测试的共享支撑：读集群拓扑，并据此算出某个 key 落在哪个 master 上。
+ *
+ * <p>两件事：
+ * <ul>
+ *   <li>{@code masterAddresses} —— 集群里有哪些 master（host:port）；</li>
+ *   <li>{@code countKeysPerMaster} —— 这一批 key 各自落在哪个 master 上。</li>
+ * </ul>
+ *
+ * <p>为什么需要它：**「key 落在多个 master 上」这件事必须被断言**，
+ * 否则一个只扫了第一个 master 的实现也能让测试变绿。
+ */
+final class RedisClusterTestSupport {
+
+    private RedisClusterTestSupport() {
+    }
+
+    /**
+     * 集群里所有 master 的 host:port。
+     *
+     * <p>返回的地址**只取 CLUSTER SLOTS 的 master 段**：JedisCluster 的连接池里
+     * 也包含副本，而副本广播的地址（172.21.0.3:638x）在宿主机上**不可达**，
+     * 拿它们建连会超时。所以这里是借一个 master 的连接去问拓扑，再从回复里
+     * 取 master 段，而不是把连接池里的地址直接返回。
+     *
+     * <p>读不到拓扑就抛异常，**不**返回空列表：空列表会让调用方把
+     * 「一个错误都没测到」当成「一个错误都没有」。
+     */
+    static List<String> masterAddresses(RedisTemplate<String, Object> template) {
+        LinkedHashSet<String> masters = new LinkedHashSet<String>();
+        for (Object range : readClusterSlots(template)) {
+            List<?> r = (List<?>) range;
+            List<?> master = (List<?>) r.get(2);
+            String host = new String((byte[]) master.get(0), StandardCharsets.UTF_8);
+            int port = ((Number) master.get(1)).intValue();
+            masters.add(host + ":" + port);
+        }
+        return new ArrayList<String>(masters);
+    }
+
+    /**
+     * 统计每个 master 各自持有本次这批 key 的多少个。
+     *
+     * <p>用 CLUSTER SLOTS 拿到 slot -&gt; master 的映射，再用 KEYSLOT 算出每个 key
+     * 的槽位，然后按属主计数。
+     */
+    static Map<String, Integer> countKeysPerMaster(RedisTemplate<String, Object> template,
+            Set<String> keys) {
+        Map<Integer, String> slotOwner = new LinkedHashMap<Integer, String>();
+        for (Object range : readClusterSlots(template)) {
+            List<?> r = (List<?>) range;
+            List<?> master = (List<?>) r.get(2);
+            String host = new String((byte[]) master.get(0), StandardCharsets.UTF_8);
+            int port = ((Number) master.get(1)).intValue();
+            String hostPort = host + ":" + port;
+            for (int slot = toNumber(r.get(0)); slot <= toNumber(r.get(1)); slot++) {
+                slotOwner.put(slot, hostPort);
+            }
+        }
+
+        Map<String, Integer> counts = new LinkedHashMap<String, Integer>();
+        for (String key : keys) {
+            int slot = JedisClusterCRC16.getSlot(key.getBytes(StandardCharsets.UTF_8));
+            String owner = slotOwner.get(slot);
+            if (owner == null) {
+                throw new IllegalStateException("no slot owner for slot " + slot + " (key " + key + ")");
+            }
+            Integer count = counts.get(owner);
+            counts.put(owner, count == null ? 1 : count + 1);
+        }
+        return counts;
+    }
+
+    /**
+     * 从第一个连得上的节点读 CLUSTER SLOTS。
+     *
+     * <p>一个都读不到就抛异常，并带上最后那个错误和试过的节点 ——
+     * 静默返回空结果会让上层的断言变成空转（「没测到」和「测了没问题」
+     * 长得一模一样）。
+     */
+    private static List<Object> readClusterSlots(RedisTemplate<String, Object> template) {
+        JedisConnectionFactory factory = (JedisConnectionFactory) template.getConnectionFactory();
+        JedisCluster nativeCluster = ((JedisClusterConnection) factory.getConnection())
+                .getNativeConnection();
+
+        String lastError = null;
+        for (JedisPool pool : nativeCluster.getClusterNodes().values()) {
+            Jedis seed = null;
+            try {
+                seed = pool.getResource();
+                return seed.clusterSlots();
+            } catch (Exception e) {
+                // 试下一个节点：集群里可能有宿主机不可达的地址
+                lastError = e.getClass().getSimpleName() + ": " + e.getMessage();
+            } finally {
+                if (seed != null) {
+                    seed.close();
+                }
+            }
+        }
+        throw new IllegalStateException("could not read CLUSTER SLOTS from any node"
+                + (lastError == null
+                        ? "; no node could be probed (the cluster client knows no node)"
+                        : "; last error was " + lastError)
+                + "; nodes=" + nativeCluster.getClusterNodes().keySet());
+    }
+
+    private static int toNumber(Object value) {
+        return ((Number) value).intValue();
+    }
+}
