+                String expected = keys.get(i).endsWith(":missing")
+                        ? null : "value-" + keys.get(i).substring(keys.get(i).lastIndexOf(':') + 1);
+                if (expected == null) {
+                    assertTrue(read.get(i).isEmpty(),
+                            "a missing key must read back as an empty hash: " + keys.get(i));
+                } else {
