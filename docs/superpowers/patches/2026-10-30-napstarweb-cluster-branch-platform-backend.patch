+    /**
+     * 一个批次必须真的被分到多个 master —— 否则「分组」这件事根本没被验证。
+     *
+     * <p>名字里的 {@code WithoutAnyMovedRedirect} 是**承重的那半句**：
+     * 分组坏掉时写和读都**照样成功**（MOVED 之后逐 key 兜底），
+     * 唯一能判定的信号是服务端收到的 MOVED 次数。
+     */
+    @Test
+    void readSideSpreadsTheBatchAcrossSeveralMastersWithoutAnyMovedRedirect() {
+        withLiveCluster((template, pipeline) -> {
+            Map<String, Map<String, String>> batch = new LinkedHashMap<>();
+            for (int i = 0; i < 300; i++) {
+                Map<String, String> hash = new LinkedHashMap<>();
+                hash.put("f", "v" + i);
+                // 读侧用**自己的** key 前缀：写侧那条用例也用 "spread:"，
+                // 而 cleanUp 把所有异常都吞了 —— 万一某次清理失败，
+                // 两个用例共用 key 就会互相顶替（一个用例的数据满足另一个的断言）。
+                batch.put(KEY_PREFIX + "readspread:" + i, hash);
+            }
+            pipeline.putAllHashes(batch);
+
+            List<String> keys = new ArrayList<>(batch.keySet());
+            // 这批 key 必须落在多个 master 上 —— 只扫第一个 master 的实现也必须被抓出来
+            Map<String, Integer> perMaster =
+                    RedisClusterTestSupport.countKeysPerMaster(template, new LinkedHashSet<>(keys));
+            int mastersWithKeys = 0;
+            for (Integer count : perMaster.values()) {
+                if (count != null && count > 0) {
+                    mastersWithKeys++;
+                }
+            }
+            assertTrue(mastersWithKeys > 1,
+                    "the batch must span several masters, but spanned " + mastersWithKeys
+                            + " (" + perMaster + ")");
+
+            // **读侧**的分组对不对，只能看服务端收到的 MOVED 次数：
+            // 分组正确时每个 key 都直接发给它的属主 master，一次 MOVED 都不该有；
+            // 分组坏掉时所有 key 挤到第一个 master，其中约 2/3 会被回 MOVED，
+            // 读侧再逐 key 兜底 —— **结果照样正确，但每个 key 多走一次往返**。
+            // 只断言「结果对」是抓不住这种坏掉的。
+            //
+            // ⚠️ 这条只证明「分组正确 ⇒ 服务端一次 MOVED 都不回」。
+            // 它**不能**证明读路径确实走了「每 master 一条 pipeline」——
+            // 兜底成逐 key 读时 JedisCluster 自己按槽路由，同样一次 MOVED 都不回。
+            // 「读路径确实用了 pipeline」由 Mockito 用例
+            // getAllHashesReturnsOneEntryPerKeyInTheGivenOrder 钉住。
+            //
+            // ⚠️ MOVED 计数是**整个集群累计**的计数器（errorstat_MOVED），
+            // 所以这里只能看**增量**；集群上有别的流量时增量会大于 0，
+            // 这条用例需要一台**没有别的读写流量**的集群。
+            long before = totalMovedErrors(template);
+            List<Map<String, Object>> read = pipeline.getAllHashes(keys);
+            long after = totalMovedErrors(template);
+
+            // MOVED 断言放在**前面**：结果条数不对时，先把重定向的证据摊开，
+            // 否则「条数不对」会把「分组坏了」这条更根本的证据盖掉。
+            assertEquals(0L, after - before,
+                    "the read batch was redirected " + (after - before)
+                            + " times; the read-side per-master grouping is broken"
+                            + " (every redirected key costs an extra round trip)"
+                            + " -- before=" + before + " after=" + after
+                            + " detail=[" + lastMovedDiag + "]");
+            assertEquals(keys.size(), read.size());
+            for (int i = 0; i < keys.size(); i++) {
+                assertNotNull(read.get(i), "no result at index " + i + " for key " + keys.get(i));
+                assertEquals("v" + i, String.valueOf(read.get(i).get("f")),
+                        "value mismatch at index " + i + " for key " + keys.get(i));
+            }
+        });
+    }
