# E2E control fixture — the machine cluster-config.sh itself runs on.
#
# Needs: bash (the script requires 4+), sshpass + openssh-client (every remote
# step), redis-tools (the `--cluster create` path when redis-cli is present
# locally), procps/coreutils (diagnostics and the driver's own plumbing).
#
# The repo is bind-mounted at /repo at run time; nothing is baked in here.
FROM docker.m.daocloud.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        bash sshpass openssh-client redis-tools coreutils procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /repo
CMD ["/bin/bash"]