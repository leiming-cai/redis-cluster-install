# cluster.conf — Redis 集群配置
#
# 用法：cp cluster.conf.example cluster.conf，然后按实际情况修改。
# cluster.conf 含集群密码，不应提交到版本库。
#
# 解析器不会执行本文件中的任何内容，只做键值切分。
#
# '#' 只能出现在一整行的开头，即只支持整行注释。值后面写 '# ...'
# 会直接报错而不是被吞进值里 —— 密码里出现 '#' 是合法字符，静默截断比
# 报错更危险。注释请单独写一行。

# ---------------------------------------------------------------------------
# 全局配置
# ---------------------------------------------------------------------------

# Redis 安装根目录。必须与目标节点上的实际路径一致，否则生成的配置与
# systemd 单元会指向不同目录，在 ProtectSystem=strict 下导致无法启动。
redis_prefix = /opt/software/redis

# 集群密码。必填。同时用作 redis.conf 的 requirepass 与 masterauth。
cluster_password = CHANGE_ME

# redis.conf 的 bind 地址。
bind_addr = 0.0.0.0

# ---------------------------------------------------------------------------
# 节点配置
# ---------------------------------------------------------------------------
# [node.X] 的 X 仅作标签，用于映射环境变量 NODE_X_*，不影响语义。
# 节点按文件中出现顺序处理。
# 注意：段名必须以小写 node. 开头且 X 非空、不含空白 —— 写成 [nodes.a]、[a]
# 或 [Node.a] 会直接报错，因为这些写法会让 NODE_A_* 环境变量静默失效。
# 段名内也不能含方括号：[node.a]]、[node.a]x、[node.a][node.b] 一律报错。
# 后者尤其重要 —— 它正是手写配置漏掉一个换行时的样子，会把两个节点组
# 悄悄合并成一个，node.b 从此不存在但实例数校验照样通过。
#
# ports 的每个元素和 ssh_port 都必须是 1-65535 的十进制整数，用逗号分隔。
# `ports = 6379 6380 6381`（空格）不会被切分，`ports = abc` 也不是端口，
# 两者都会直接报错，而不是当成 1 个或 3 个实例混过下面的下限校验。
#
# 计数单位是「实例数」而不是「节点组数」：每个端口就是一个集群实例。
# 本脚本固定 replicas=1，master 数 = ceil(实例数 / 2)，
# 而 redis-cli --cluster create 要求至少 3 个 master，
# 因此实例总数必须 >= 5 —— 上面的示例是 2 个节点组、共 6 个实例（3 主 3 从）。
#
# 常见陷阱：只数节点组数，会把标准的「A 机 3 实例 + B 机 3 实例」误判为
# 只有 1 个 master 而错误拒绝。

[node.a]
host     = 192.168.1.10
ssh_port = 22
ports    = 6379,6380,6381

[node.b]
host     = 192.168.1.11
ssh_port = 22
ports    = 6382,6383,6384