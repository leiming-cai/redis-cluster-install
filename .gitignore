# Build artifacts
*.o
*.so
*.a
redis-8.8.0/
src/redis-server
src/redis-cli
src/redis-sentinel

# Local source tarball - regenerate from canonical source
redis-*.tar.gz

# Secrets (SSH password, cluster auth) — directory is runtime-created
# but .gitkeep is allowed so the dir exists on fresh clone
secrets/*
!secrets/.gitkeep
!secrets/.gitignore

# Logs
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent runtime state (Sisyphus/Omo session bookkeeping)
.omo/

# Stray debug / npm artifacts
package-lock.json

# Cluster config (contains cluster_password)
cluster.conf
