+/**
+ * Redis 实时数据写入服务（集群/单机/哨兵自适应）
+ * @Author: caileiming boboclmomi@163.com
+ * @Date: 2025-05-27 11:37:36
+ * @LastEditors: caileiming boboclmomi@163.com
+ * @LastEditTime: 2026-10-22 10:00:00
+ * @Description: Redis 实时数据写入。单机/哨兵使用 pipeline；集群交给 RedisClusterHashPipeline
+ *               按 slot 属主归并为「每主节点一条 pipeline」。本类不再标注 @Async，
+ *               异步只保留在 Kafka 写入入口，便于统一重试与异常观测。
+ */
+package com.sac.platform.realserver.service.impl;
+
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+
+import org.apache.commons.lang3.StringUtils;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.data.redis.core.RedisCallback;
+import org.springframework.data.redis.core.RedisTemplate;
+import org.springframework.data.redis.serializer.RedisSerializer;
+import org.springframework.stereotype.Service;
+
+import com.sac.platform.common.utils.SystemIDUtil;
+import com.sac.platform.config.SecSetCounter;
+import com.sac.platform.config.TotalSetCounter;
+import com.sac.platform.realserver.oms.utils.RedisClusterHashPipeline;
+import com.sac.platform.realserver.oms.utils.RedisClusterHelper;
+import com.sac.platform.realserver.service.RedisRealDataService;
+
+@Service
+public class RedisRealDataServiceImpl implements RedisRealDataService {
+
+    private static final Logger logger = LoggerFactory.getLogger(RedisRealDataServiceImpl.class);
+
+    /** 日志中单条点数据最大展示长度，避免大 batch 打出海量内容 */
+    private static final int LOG_PREVIEW_LENGTH = 120;
+
+    private final RedisTemplate<String, Object> redisTemplate;
+    private final boolean isCluster;
+    private final RedisClusterHashPipeline clusterPipeline;
+
+    public RedisRealDataServiceImpl(RedisTemplate<String, Object> redisTemplate,
+            RedisClusterHelper redisClusterHelper,
+            RedisClusterHashPipeline clusterPipeline) {
+        this.redisTemplate = redisTemplate;
+        // 通过统一的 RedisClusterHelper 判断集群模式（哨兵同样走单机 pipeline）
+        this.isCluster = redisClusterHelper.isCluster();
+        this.clusterPipeline = clusterPipeline;
+    }
+
+    /**
+     * 实时数据写入入口
+     * 单机/哨兵：使用 pipeline（按 key 分组 hMSet，RTT 最小）
+     * 集群：交给 RedisClusterHashPipeline，按 slot 属主归并为每主节点一条 pipeline
+     *
+     * 注意：本方法为同步执行，异常直接抛给调用方（Kafka 写入入口负责重试与记录）。
+     */
+    @Override
+    public CompletableFuture<Boolean> wirteOmsPip(String prefix, List<String> pointData) {
+        if (pointData == null || pointData.isEmpty()) {
+            return CompletableFuture.completedFuture(true);
+        }
+        if (isCluster) {
+            return batchWirteOmsByRedisCluster(prefix, pointData);
+        }
+        return wirteOmsPipStandalone(prefix, pointData);
+    }
+
+    /**
+     * 单机/哨兵模式：按 key 分组后使用 pipeline 批量 hMSet。
+     * 计数在整批写入成功后一次性累加，失败重试不会重复计数。
+     */
+    private CompletableFuture<Boolean> wirteOmsPipStandalone(String prefix, List<String> pointData) {
+        final Map<String, Map<String, String>> grouped = groupByKey(prefix, pointData);
+        if (grouped.isEmpty()) {
+            return CompletableFuture.completedFuture(true);
+        }
+
+        @SuppressWarnings("rawtypes")
+        RedisSerializer keySerializer = redisTemplate.getKeySerializer();
+        @SuppressWarnings("rawtypes")
+        RedisSerializer hashValueSerializer = redisTemplate.getHashValueSerializer();
+        @SuppressWarnings("rawtypes")
+        RedisSerializer hashKeySerializer = redisTemplate.getHashKeySerializer();
+
+        int fieldCount = 0;
+        for (Map<String, String> hash : grouped.values()) {
+            fieldCount += hash.size();
+        }
+
+        redisTemplate.executePipelined((RedisCallback<Object>) redisConnection -> {
+            for (Map.Entry<String, Map<String, String>> entry : grouped.entrySet()) {
+                Map<byte[], byte[]> hash = new HashMap<>(entry.getValue().size());
+                for (Map.Entry<String, String> field : entry.getValue().entrySet()) {
+                    hash.put(hashKeySerializer.serialize(field.getKey()),
+                            hashValueSerializer.serialize(field.getValue()));
+                }
+                redisConnection.hMSet(keySerializer.serialize(entry.getKey()), hash);
+            }
+            return null;
+        });
+
+        TotalSetCounter.add(fieldCount);
+        SecSetCounter.add(fieldCount);
+        return CompletableFuture.completedFuture(true);
+    }
+
+    @Override
+    public CompletableFuture<Boolean> wirteOmsPipByJedis(String prefix, List<String> pointData) {
+        // 当前实现已统一到 wirteOmsPip 中
+        return wirteOmsPip(prefix, pointData);
+    }
+
+    /**
+     * 集群模式：整批交给 RedisClusterHashPipeline，按 slot 属主归并为「每主节点一条 pipeline」。
+     * 计数在整批（所有节点）都成功之后一次性累加；任何失败都直接抛出，
+     * 由调用方整批重试（HSET 幂等），重试不会重复计数。
+     */
+    @Override
+    public CompletableFuture<Boolean> batchWirteOmsByRedisCluster(String prefix, List<String> pointData) {
+        Map<String, Map<String, String>> grouped = groupByKey(prefix, pointData);
+        if (grouped.isEmpty()) {
+            return CompletableFuture.completedFuture(true);
+        }
+        int fieldCount = 0;
+        for (Map<String, String> hash : grouped.values()) {
+            fieldCount += hash.size();
+        }
+        clusterPipeline.putAllHashes(grouped);
+        TotalSetCounter.add(fieldCount);
+        SecSetCounter.add(fieldCount);
+        return CompletableFuture.completedFuture(true);
+    }
+
+    /**
+     * 解析并分组：obid;atype,datatype,value,time&obid;...
+     * 每个点独立容错，坏点只跳过该点，不影响整批。
+     */
+    private Map<String, Map<String, String>> groupByKey(String prefix, List<String> pointData) {
+        Map<String, Map<String, String>> grouped = new LinkedHashMap<>();
+        for (String data : pointData) {
+            if (StringUtils.isBlank(data) || !data.contains(";")) {
+                continue;
+            }
+            try {
+                String[] dataItem = data.split(";");
+                long obid = Long.parseLong(dataItem[0].trim());
+                int otype = SystemIDUtil.extractOType(obid);
+                String key = prefix + ":" + otype + ":" + obid;
+
+                Map<String, String> hash = new HashMap<>();
+                for (int num = 1; num < dataItem.length; num++) {
+                    String[] contents = dataItem[num].split(",");
+                    if (contents.length < 4) {
+                        logger.warn("Skip malformed field: point={}", preview(data));
+                        continue;
+                    }
+                    String atype = contents[0];
+                    String value = contents[2] + "," + contents[3] + "," + contents[1];
+                    hash.put(atype, value);
+                }
+
+                if (hash.isEmpty()) {
+                    continue;
+                }
+                Map<String, String> existing = grouped.get(key);
+                if (existing == null) {
+                    grouped.put(key, hash);
+                } else {
+                    existing.putAll(hash);
+                }
+            } catch (Exception e) {
+                logger.warn("Skip invalid point data: {}, reason: {}", preview(data), e.getMessage());
+            }
+        }
+        return grouped;
+    }
+
+    private static String preview(String data) {
+        if (data == null) {
+            return "null";
+        }
+        return data.length() <= LOG_PREVIEW_LENGTH ? data : data.substring(0, LOG_PREVIEW_LENGTH) + "...";
+    }
+}
