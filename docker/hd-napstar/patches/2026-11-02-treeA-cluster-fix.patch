+/**
+ * Kafka 实时数据写入服务（集群/单机/哨兵自适应）
+ * @Author: caileiming boboclmomi@163.com
+ * @Date: 2022-06-13 15:48:25
+ * @LastEditors: caileiming boboclmomi@163.com
+ * @LastEditTime: 2026-10-28 10:00:00
+ * @Description: Kafka 数据写入 Redis，集群/单机/哨兵模式自适应。
+ *               写入失败做有限重试并记录失败点数，避免哨兵切换期间静默丢数据。
+ */
+package com.sac.platform.realserver.service.impl;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.apache.commons.lang3.StringUtils;
+import org.apache.kafka.clients.consumer.ConsumerRecord;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.data.redis.core.RedisCallback;
+import org.springframework.data.redis.core.RedisTemplate;
+import org.springframework.data.redis.serializer.RedisSerializer;
+import org.springframework.scheduling.annotation.Async;
+import org.springframework.stereotype.Service;
+
+import com.sac.platform.common.utils.SystemIDUtil;
+import com.sac.platform.config.FailSetCounter;
+import com.sac.platform.config.SecSetCounter;
+import com.sac.platform.config.TotalSetCounter;
+import com.sac.platform.realserver.oms.utils.RedisClusterHelper;
+import com.sac.platform.realserver.service.BatchOmsWriteService;
+import com.sac.platform.realserver.service.RedisRealDataService;
+
+@Service
+public class OmsWriteByKafkaServiceImpl implements BatchOmsWriteService<String> {
+
+    private static final Logger logger = LoggerFactory.getLogger(OmsWriteByKafkaServiceImpl.class);
+
+    /** 失败重试的退避时间（毫秒），长度 + 1 即总尝试次数 */
+    private static final long[] RETRY_DELAYS_MS = { 200L, 500L };
+    private static final int MAX_ATTEMPTS = RETRY_DELAYS_MS.length + 1;
+
+    /** 日志中单条数据最大展示长度 */
+    private static final int LOG_PREVIEW_LENGTH = 120;
+
+    private final RedisTemplate<String, Object> redisTemplate;
+    private final RedisRealDataService redisRealDataService;
+    private final boolean isCluster;
+
+    public OmsWriteByKafkaServiceImpl(RedisTemplate<String, Object> redisTemplate,
+            RedisRealDataService redisRealDataService,
+            RedisClusterHelper redisClusterHelper) {
+        this.redisTemplate = redisTemplate;
+        this.redisRealDataService = redisRealDataService;
+        // 通过统一的 RedisClusterHelper 判断集群模式（哨兵按单机处理）
+        this.isCluster = redisClusterHelper.isCluster();
+    }
+
+    /**
+     * 批量写入入口
+     * 集群模式：拆分数据后委托给 redisRealDataService（自动分片）
+     * 单机/哨兵模式：使用 pipeline（高性能）
+     */
+    @Async(value = "consumerRunExecutor")
+    @Override
+    public void batchWirte(List<String> data, String prefix) {
+        if (data == null || data.isEmpty()) {
+            return;
+        }
+        try {
+            if (isCluster) {
+                // 集群：转换数据格式后委托给 RedisRealDataService
+                List<String> pointList = parseToPointList(data);
+                if (!pointList.isEmpty()) {
+                    writeWithRetry("batchWirte", prefix, pointList,
+                            () -> redisRealDataService.wirteOmsPip(prefix, pointList).join());
+                }
+            } else {
+                writeWithRetry("batchWirte", prefix, data,
+                        () -> batchWirteStandalone(data, prefix));
+            }
+        } catch (Exception e) {
+            logger.error("batchWirte unexpected error, prefix={}, size={}", prefix, data.size(), e);
+        }
+    }
+
+    /**
+     * 单机/哨兵模式：使用 pipeline
+     * obid;atype,datatype,value,time
+     * 计数在整批写入成功后累加，失败重试不会重复计数。
+     */
+    private void batchWirteStandalone(List<String> data, String prefix) {
+        @SuppressWarnings("rawtypes")
+        RedisSerializer keySerializer = redisTemplate.getKeySerializer();
+        @SuppressWarnings("rawtypes")
+        RedisSerializer hashValueSerializer = redisTemplate.getHashValueSerializer();
+        @SuppressWarnings("rawtypes")
+        RedisSerializer hashKeySerializer = redisTemplate.getHashKeySerializer();
+
+        final int[] fieldCount = { 0 };
+        redisTemplate.executePipelined((RedisCallback<Object>) redisConnection -> {
+            for (String item : data) {
+                if (StringUtils.isBlank(item)) {
+                    continue;
+                }
+                fieldCount[0] += processItem(item, prefix, keySerializer, hashKeySerializer, hashValueSerializer,
+                        redisConnection);
+            }
+            return null;
+        });
+
+        TotalSetCounter.add(fieldCount[0]);
+        SecSetCounter.add(fieldCount[0]);
+    }
+
+    /**
+     * 处理单条数据：拆分 & 分组后调用 hSet，返回成功写入的 field 数。
+     * 单条解析失败只跳过该条，不影响整批。
+     * 注意：单机/哨兵 pipeline 中如果存在不同 key，集群下会跨 slot 报错
+     */
+    private int processItem(String item, String prefix,
+            @SuppressWarnings("rawtypes") RedisSerializer keySerializer,
+            @SuppressWarnings("rawtypes") RedisSerializer hashKeySerializer,
+            @SuppressWarnings("rawtypes") RedisSerializer hashValueSerializer,
+            org.springframework.data.redis.connection.RedisConnection redisConnection) {
+        int fieldCount = 0;
+        try {
+            String[] dataRecord = item.split("&");
+            for (String pointData : dataRecord) {
+                if (StringUtils.isBlank(pointData)) {
+                    continue;
+                }
+                String[] dataItem = pointData.split(";");
+                if (dataItem.length == 0) {
+                    continue;
+                }
+                Long obid = Long.parseLong(dataItem[0].trim());
+                int otype = SystemIDUtil.extractOType(obid);
+                String key = prefix + ":" + otype + ":" + obid;
+                for (int num = 1; num < dataItem.length; num++) {
+                    String[] contents = dataItem[num].split(",");
+                    if (contents.length < 4) {
+                        logger.warn("Skip malformed field: point={}", preview(item));
+                        continue;
+                    }
+                    String atype = contents[0];
+                    String value = contents[2] + "," + contents[3] + "," + contents[1];
+                    redisConnection.hSet(keySerializer.serialize(key),
+                            hashKeySerializer.serialize(atype),
+                            hashValueSerializer.serialize(value));
+                    fieldCount++;
+                }
+            }
+        } catch (Exception e) {
+            logger.warn("Skip invalid point data: {}, reason: {}", preview(item), e.getMessage());
+            return 0;
+        }
+        return fieldCount;
+    }
+
+    /**
+     * 解析 & 分割格式：obid;atype,datatype,value,time&obid;...
+     * 返回扁平化的 pointData 列表（每条: obid;atype,...）
+     */
+    private List<String> parseToPointList(List<String> data) {
+        List<String> pointList = new ArrayList<>();
+        for (String item : data) {
+            if (StringUtils.isBlank(item)) {
+                continue;
+            }
+            String[] dataRecord = item.split("&");
+            for (String record : dataRecord) {
+                if (StringUtils.isNotBlank(record)) {
+                    pointList.add(record);
+                }
+            }
+        }
+        return pointList;
+    }
+
+    /**
+     * pipeline 写入入口（单机/哨兵与集群统一走 redisRealDataService）。
+     */
+    @Async(value = "consumerRunExecutor")
+    @Override
+    public void batchWirtePip(List<String> data, String prefix) {
+        if (data == null || data.isEmpty()) {
+            return;
+        }
+        try {
+            List<String> pointList = parseToPointList(data);
+            if (pointList.isEmpty()) {
+                return;
+            }
+            writeWithRetry("batchWirtePip", prefix, pointList,
+                    () -> redisRealDataService.wirteOmsPip(prefix, pointList).join());
+        } catch (Exception e) {
+            logger.error("batchWirtePip unexpected error, prefix={}, size={}", prefix, data.size(), e);
+        }
+    }
+
+    /**
+     * 有限重试：失败后按 200ms、500ms 退避重试，最多尝试 MAX_ATTEMPTS 次。
+     * 全部失败时记录 ERROR 并累加失败点数（failover 期间丢弃当前批次，后续批次自然补上）。
+     */
+    private void writeWithRetry(String scene, String prefix, List<String> data, Runnable action) {
+        for (int attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
+            try {
+                action.run();
+                return;
+            } catch (Exception e) {
+                if (attempt == MAX_ATTEMPTS) {
+                    FailSetCounter.add(data.size());
+                    logger.error("{} write failed after {} attempts, prefix={}, points={}, firstPoint={}",
+                            scene, attempt, prefix, data.size(), preview(data.get(0)), e);
+                    return;
+                }
+                long delay = RETRY_DELAYS_MS[attempt - 1];
+                logger.warn("{} write failed (attempt {}/{}), prefix={}, points={}, retry in {}ms: {}",
+                        scene, attempt, MAX_ATTEMPTS, prefix, data.size(), delay, e.getMessage());
+                try {
+                    Thread.sleep(delay);
+                } catch (InterruptedException ie) {
+                    Thread.currentThread().interrupt();
+                    FailSetCounter.add(data.size());
+                    logger.error("{} write interrupted, prefix={}, points={}", scene, prefix, data.size(), ie);
+                    return;
+                }
+            }
+        }
+    }
+
+    private static String preview(String data) {
+        if (data == null) {
+            return "null";
+        }
+        return data.length() <= LOG_PREVIEW_LENGTH ? data : data.substring(0, LOG_PREVIEW_LENGTH) + "...";
+    }
+
+    /**
+     * 批量写入。
+     *
+     * 集群与单机统一走 redisRealDataService：它在集群模式下按 slot 分组 pipeline，
+     * 在单机模式下用 executePipelined。
+     *
+     * 原先这里还有一条「单机用裸 Jedis pipeline」的分支（batchWirteJedisStandalone），
+     * 已删除——它依赖 jedis.properties 构造单节点 JedisPool，而该文件在生产环境并不存在
+     * （静态初始化直接 NPE）；且集群下单节点 Jedis 根本无法跨节点 pipeline。
+     */
+    public void batchWirteJedis(List<ConsumerRecord<String, String>> data, String prefix) {
+        if (data == null || data.isEmpty()) {
+            return;
+        }
+        List<String> pointList = new ArrayList<>();
+        for (ConsumerRecord<String, String> record : data) {
+            if (record.key() != null && record.value() != null) {
+                pointList.add(record.key() + ";" + record.value());
+            }
+        }
+        redisRealDataService.wirteOmsPip(prefix, pointList);
+    }
+
+}
