+package com.sac.platform.realserver.service.impl;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.ArgumentMatchers.anyList;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.when;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.concurrent.CompletableFuture;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import org.springframework.data.redis.core.RedisTemplate;
+
+import com.sac.platform.config.FailSetCounter;
+import com.sac.platform.realserver.oms.utils.RedisClusterHelper;
+import com.sac.platform.realserver.service.RedisRealDataService;
+
+/**
+ * 写入重试与失败计数测试。
+ * 单测中没有 Spring 代理，@Async 不生效，方法同步执行。
+ */
+@ExtendWith(MockitoExtension.class)
+class OmsWriteByKafkaServiceImplTest {
+
+    @Mock
+    private RedisTemplate<String, Object> redisTemplate;
+
+    @Mock
+    private RedisRealDataService redisRealDataService;
+
+    @Mock
+    private RedisClusterHelper redisClusterHelper;
+
+    private OmsWriteByKafkaServiceImpl service;
+
+    @BeforeEach
+    void setUp() {
+        when(redisClusterHelper.isCluster()).thenReturn(false);
+        service = new OmsWriteByKafkaServiceImpl(redisTemplate, redisRealDataService, redisClusterHelper);
+        FailSetCounter.reset();
+    }
+
+    @Test
+    void batchWirtePipSucceedsOnThirdAttempt() {
+        when(redisRealDataService.wirteOmsPip(eq("real_data"), anyList()))
+                .thenThrow(new RuntimeException("first failure"))
+                .thenThrow(new RuntimeException("second failure"))
+                .thenReturn(CompletableFuture.completedFuture(true));
+
+        service.batchWirtePip(Arrays.asList("1;2,3,4,5"), "real_data");
+
+        verify(redisRealDataService, times(3)).wirteOmsPip(eq("real_data"), anyList());
+        assertEquals(0L, FailSetCounter.getCount());
+    }
+
+    @Test
+    void batchWirtePipCountsAllPointsAfterRetriesExhausted() {
+        when(redisRealDataService.wirteOmsPip(eq("real_data"), anyList()))
+                .thenThrow(new RuntimeException("always failing"));
+
+        service.batchWirtePip(Arrays.asList("1;2,3,4,5", "2;2,3,4,5"), "real_data");
+
+        verify(redisRealDataService, times(3)).wirteOmsPip(eq("real_data"), anyList());
+        assertEquals(2L, FailSetCounter.getCount());
+    }
+
+    @Test
+    void batchWirtePipIgnoresEmptyInput() {
+        service.batchWirtePip(Collections.<String>emptyList(), "real_data");
+
+        verifyNoInteractions(redisRealDataService);
+    }
+
+    @Test
+    void batchWirtePipIgnoresBlankRecords() {
+        service.batchWirtePip(Arrays.asList("", "   "), "real_data");
+
+        verifyNoInteractions(redisRealDataService);
+    }
+}
